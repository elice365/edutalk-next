{
  "functions": {
    "app/api/**/*.js": {
      "maxDuration": 30
    }
  },
  "regions": ["icn1"],
  "env": {
    "NODE_ENV": "production"
  },
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  },
  "outputDirectory": ".next",
  "ignoreCommand": "npm run build",
  "crons": [
    {
      "path": "/api/health",
      "schedule": "0 3 * * *"
    }
  ]
}